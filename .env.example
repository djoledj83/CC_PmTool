# ---------------------------------------------------------------------------
# Root .env — read automatically by `docker compose` for ${VAR} substitution
# in docker-compose.yml. Copy this file to `.env` (git-ignored) and fill it
# in on first run. Anything left unset falls back to the localhost defaults
# in docker-compose.yml — EXCEPT the JWT secrets, which are required.
# ---------------------------------------------------------------------------

# ----- Branding (per customer) --------------------------------------------
# Product name shown in the UI, browser tab, emails and Excel exports.
APP_NAME=PM Tool
# Legal entity in the "© <year> <holder>. All rights reserved." line.
COPYRIGHT_HOLDER=Your Company
# Logos: replace the placeholder SVGs listed in TEMPLATE_SETUP.md.

# ----- Public URLs --------------------------------------------------------
# What users type into the browser / what the browser calls for the API.
# Local dev:      http://localhost:3000 / http://localhost:5000
# Remote server:  http://<server-ip-or-domain>:3000 / :5000
APP_ORIGIN=http://localhost:3000
API_URL=http://localhost:5000

# Host ports (left side of the port mappings in docker-compose.yml).
# FRONTEND_PORT=3000
# BACKEND_PORT=5000

# Secure flag on the refresh cookie. Keep `false` on plain HTTP; set to
# `true` only once the app is served over HTTPS.
COOKIE_SECURE=false

# ----- JWT signing secrets (REQUIRED) -------------------------------------
# At least 32 characters, unique per deployment. Generate with:
#   openssl rand -hex 48
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ----- Corporate proxy (only if the Docker host needs one to build) --------
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# ----- Where data lives on the host ----------------------------------------
# By default uploads and logs are stored in Docker NAMED VOLUMES
# (pm_uploads / pm_logs) under /var/lib/docker/volumes/. To keep them in a
# folder you choose, set absolute host paths (bind mounts):
#   UPLOADS_PATH -> uploaded files (avatars, attachments); container /app/uploads
#   LOGS_PATH    -> log files; container /app/logs
# UPLOADS_PATH=/srv/pmtool/uploads
# LOGS_PATH=/srv/pmtool/logs
#
# Switching from a named volume to a host path does NOT move existing
# files. Copy them once before restarting, e.g.:
#   mkdir -p /srv/pmtool/uploads
#   docker run --rm -v <project>_pm_uploads:/from -v /srv/pmtool/uploads:/to \
#     alpine sh -c 'cp -a /from/. /to/'
# (`docker volume ls` shows the exact volume name.)

# ----- Backups ------------------------------------------------------------
# Used by scripts/backup.sh — where DB dumps + uploads archives are written.
# BACKUPS_PATH=/srv/pmtool/backups
