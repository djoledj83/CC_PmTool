{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        },
        "jsx": "react-jsx",
        "module": "ESNext",
        "target": "ES2020",
        "moduleResolution": "Bundler",
        "allowSyntheticDefaultImports": true,
        "checkJs": false
    },
    "include": ["src/**/*"]
}
