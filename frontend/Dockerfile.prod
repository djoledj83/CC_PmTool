# Frontend production image.
#
# Two stages:
#   1. `build`  — node:20 + Vite produce a static bundle in /app/dist
#   2. final    — nginx:alpine serves that bundle on :80 using
#                 ./nginx.conf (CSP + caching + SPA fallback + HSTS hook)
#
# The dev image (`dockerfile`) is unchanged — it still runs `vite dev`
# with hot-reload for the local docker compose loop. To switch the
# server to nginx, change the frontend service in docker-compose.yml:
#
#   frontend:
#     build:
#       context: ./frontend
#       dockerfile: Dockerfile.prod
#       args:
#         VITE_API_URL: ${API_URL}
#     ports:
#       - "3000:80"     # nginx listens on 80; map to whatever you want
#     environment:
#       # Nothing required at runtime — VITE_API_URL was baked in at
#       # build time. Keep this block for parity with the dev image.
#       NODE_ENV: production
#
# IMPORTANT: VITE_API_URL is a BUILD-TIME variable. Changing it after
# the image is built has no effect — rebuild with --build-arg or via
# docker compose `args:` to pick up a new backend URL.

FROM node:20-alpine AS build
WORKDIR /app

ARG VITE_API_URL
ARG VITE_APP_NAME
ARG VITE_COPYRIGHT_HOLDER
ENV VITE_API_URL=${VITE_API_URL} \
    VITE_APP_NAME=${VITE_APP_NAME} \
    VITE_COPYRIGHT_HOLDER=${VITE_COPYRIGHT_HOLDER}

COPY package*.json ./
RUN npm install --no-audit --no-fund

COPY . .
RUN npm run build

# --- runtime ----------------------------------------------------------------
FROM nginx:1.27-alpine

# Drop the stock default server block so our config is the only one.
RUN rm /etc/nginx/conf.d/default.conf

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

# Container speaks plain HTTP. TLS is terminated by the external
# reverse proxy — see RELEASE_NOTES "Reverse proxy + HSTS" appendix.
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
    CMD wget -qO- http://127.0.0.1/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
