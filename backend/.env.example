# ---------------------------------------------------------------------------
# backend/.env — runtime secrets for the API container (loaded via
# docker-compose `env_file`) and for local `npm run dev`. Copy this file to
# backend/.env (git-ignored) and fill it in on first run.
# ---------------------------------------------------------------------------

# NODE_ENV=production
PORT=5000

# Postgres connection. Prisma connection-pool sizing tuned for ~300
# concurrent users:
#   connection_limit=20  (default is num_physical_cpus*2+1, which on a
#                         2-core container is just 5)
#   pool_timeout=20      seconds a request waits for a free connection
#   connect_timeout=10   seconds before a dead DB fails fast instead of
#                         stalling the boot indefinitely
# Make sure Postgres `max_connections` >= connection_limit * backend
# instances + 10 headroom (Postgres default is 100).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pmtool?connection_limit=20&pool_timeout=20&connect_timeout=10

# JWT — for local dev without docker compose. Under compose these come from
# the root .env (compose `environment:` overrides env_file). Generate with
# `openssl rand -hex 48`. Must be >= 32 chars.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Allowed browser origin(s) for the API (comma-separated).
CORS_ORIGIN=http://localhost:3000
APP_ORIGIN=http://localhost:3000

# Product name used in emails and Excel exports. Under compose this is set
# from the root .env (APP_NAME); set it here for local dev.
APP_NAME=PM Tool

# Optional SMTP for email notifications. Leave SMTP_HOST empty to skip
# sending — messages are then written to logs/sent-mail.log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PM Tool" <no-reply@example.com>
